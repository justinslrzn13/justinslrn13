nav{display:flex;align-items:center;gap:22px;font-size:15px}
nav a{text-decoration:none;color:var(--muted)}
nav a:hover{color:#fff}
.lang{display:flex;border:1.5px solid var(--line);border-radius:30px;overflow:hidden}
.lang button{background:none;border:0;color:var(--muted);font:600 13px inherit;font-family:inherit;padding:6px 12px;cursor:pointer}
.lang button.on{background:var(--accent);color:var(--bg)}
.hero{padding:90px 0 70px}
.tag{font-size:14px;letter-spacing:4px;color:var(--accent);font-weight:600}
h1{font-size:clamp(40px,7vw,72px);line-height:1.05;font-weight:800;letter-spacing:-1.5px;margin-top:14px}
h1 span{color:var(--accent)}
.sub{font-size:clamp(18px,2.6vw,24px);color:#cfe3ff;margin-top:18px;max-width:680px}
.chips{display:flex;flex-wrap:wrap;gap:10px;margin-top:26px}
.chip{border:1.5px solid #3d79c4;background:rgba(61,121,196,.18);padding:6px 16px;border-radius:30px;font-size:15px}
.btns{display:flex;flex-wrap:wrap;gap:14px;margin-top:34px}
.btn{display:inline-block;padding:13px 26px;border-radius:30px;font-weight:700;text-decoration:none;font-size:16px}
.btn.p{background:var(--accent);color:var(--bg)}
.btn.p:hover{background:#8fd3ff}
.btn.s{border:2px solid var(--line);color:var(--text)}
.btn.s:hover{background:var(--card)}
section{padding:64px 0}
h2{font-size:clamp(28px,4vw,38px);font-weight:800;letter-spacing:-.5px;margin-bottom:8px}
.lead{color:var(--muted);margin-bottom:34px;max-width:640px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px}
.card{background:var(--card);border:1.5px solid var(--line);border-radius:18px;padding:26px}
.card h3{font-size:20px;margin-bottom:8px}
.card p{color:#cfe3ff;font-size:16px}
.ico{width:42px;height:42px;border-radius:12px;background:var(--accent);color:var(--bg);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:18px;margin-bottom:14px}
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
.step .n{width:40px;height:40px;border-radius:50%;background:var(--accent);color:var(--bg);font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.step h3{font-size:18px;margin-bottom:6px}
.step p{color:#cfe3ff;font-size:15px}
.about{display:grid;grid-template-columns:1.4fr 1fr;gap:28px;align-items:start}
@media(max-width:760px){.about{grid-template-columns:1fr}nav a.hide{display:none}}
.about p{color:#cfe3ff;margin-bottom:14px}
.facts{list-style:none}
.facts li{padding:11px 0;border-bottom:1px solid rgba(47,95,158,.5);font-size:16px}
.facts li:last-child{border:0}
.facts b{color:var(--accent);display:block;font-size:13px;letter-spacing:2px;font-weight:600}
.cta{text-align:center;background:var(--card);border:1.5px solid var(--line);border-radius:24px;padding:54px 24px}
.cta p{color:#cfe3ff;max-width:560px;margin:10px auto 26px}
footer{text-align:center;color:var(--muted);font-size:14px;padding:34px 20px 44px}
</style>
